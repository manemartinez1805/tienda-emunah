          { "type": "number", "name": "precio", "title": "Precio en Pesos ($)" },
          { "type": "array", "name": "imagenes", "title": "Carrusel de Fotos del Producto", "of": [{ "type": "image", "options": { "hotspot": true } }] },
          { "type": "text", "name": "descripcion", "title": "Detalles o Frase de Fe" }
        ]
      }
    ]
  }
}
